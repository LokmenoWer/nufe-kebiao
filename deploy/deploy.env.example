# 复制为 deploy/deploy.env 后按实际环境填写（deploy.env 已加入 .gitignore）
HOST=deployer@your-server
SSH_KEY=~/.ssh/id_ed25519
PUBLIC_BASE_URL=https://kebiao.example.com
# 服务器管理后台 /admin 的密码哈希（留空则不开启管理后台）。生成命令：.venv/bin/python -m app.admin hash
# 哈希值包含 $ 符号，请务必使用单引号包裹
ADMIN_PASSWORD_HASH=''

# ---- 同一台机器上的其他实例（如 beta）：另建 deploy/deploy-beta.env，用 DEPLOY_ENV=deploy/deploy-beta.env deploy/deploy.sh ----
# APP_DIR=/opt/nufe-kebiao-beta   SERVICE=kebiao-beta   SVC_USER=kebiao-beta   PORT=8011
# MANAGE_UNITS=0                  # systemd 单元由服务器自己维护，不用仓库里正式服的那份覆盖
# ENV_SET="ASSIST_ENABLED=1"      # 要写进服务器 .env 的非敏感开关
