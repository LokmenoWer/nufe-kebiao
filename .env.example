# 必填：32 字节随机密钥的 Base64 编码，用于 AES-256-GCM 加密落库的 Cookie、密码、邮箱与各类 token。
# 生成命令：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 生产环境请妥善保管于密钥管理服务或环境变量中，切勿提交到代码仓库；密钥丢失后已保存的凭据将无法解密（用户重新登录即可恢复）。
APP_SECRET_KEY=

# 对外访问根地址（用于生成 .ics 订阅链接与小组件链接，以及校验请求 Origin）。以 https 开头时会自动启用 Secure Cookie、HSTS 与 HTTP→HTTPS 跳转。
PUBLIC_BASE_URL=http://localhost:8000
# 若反向代理已终止 HTTPS，但 PUBLIC_BASE_URL 临时设为 http，可手动开启以下选项：
# COOKIE_SECURE=true
# FORCE_HTTPS=true

# SQLite 数据库文件路径（相对路径基于项目根目录）
DB_PATH=./data/kebiao.db

# 登录会话有效期（天）
SESSION_DAYS_LONG=180
SESSION_DAYS_SHORT=7

# 后台自动刷新
SCHEDULER_ENABLED=true
# 每位用户的刷新频率由系统按“课前检查点 / 活跃度 / 近期课表变动”动态计算，此处仅配置调度轮询周期与全站请求预算
SCHEDULER_TICK=30
# 后台刷新每秒最多使用的学校请求配额（全站硬上限为 1 次/秒，此处最大可设 0.9）；学校服务器报错时自动减半，恢复正常后逐步回升
REFRESH_BUDGET_RPS=0.65
# 安卓 App 2.0 的“协助刷新”：把部分后台刷新经开启了该功能的手机（Wi-Fi 下）中继到教务系统，分散服务器出口 IP 的请求。
# 手机只转发服务器与教务之间端到端的 TLS 密文；需要去统一身份认证时自动交回服务器直连。默认关闭，设为 1 开启。
# App 的匿名装机统计（/api/app/heartbeat）不受此开关影响。
ASSIST_ENABLED=0
REFRESH_MAX_FAILS=3
# 手动刷新限制：两次手动刷新的最小间隔（秒），以及课表在多少秒内刚同步过则直接返回缓存而不再请求学校
MANUAL_REFRESH_MIN_GAP=20
MANUAL_REFRESH_FRESH_SECONDS=120

# 发往学校服务器的上游节流参数
UPSTREAM_MAX_CONCURRENCY=2
# 全站任意两次上游请求的最小发起间隔（秒），下限为 1.0（设得更小也会按 1.0 生效）
UPSTREAM_MIN_INTERVAL=1.0
UPSTREAM_TIMEOUT=20

# 校历锚点文件路径（相对路径基于项目根目录）
# SEMESTERS_FILE=./semesters.json

# 邮件通知（可选）。未配置 MAIL_HOST 时，前端设置页将自动隐藏“邮件通知”模块。
# MAIL_MAILER=log 时不实际发信，仅将邮件内容输出至日志（适用于本地开发与调试）。
# MAIL_PASSWORD 请填写邮箱服务商生成的 SMTP 授权码（非邮箱登录密码），切勿提交到代码仓库。
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.163.com
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME=南财课表

# 服务器管理后台 /admin（查看实时日志、在线人数、后台刷新排期等）。仅保存密码的 PBKDF2 哈希，不保存明文；未配置时管理后台返回 404。
# 生成命令：.venv/bin/python -m app.admin hash（哈希值包含 $ 符号，请务必使用单引号包裹）
# ADMIN_PASSWORD_HASH='pbkdf2_sha256$600000$<salt>$<hash>'

# 进程内热重载：生产环境可通过 systemctl reload kebiao（SIGHUP）或 /admin 页面的“热重载”按钮按需触发；
# 本地开发可开启文件监听，修改 app/*.py 或 .env 后自动在进程内热重载（保留正在进行的登录流程与节流状态）；semesters.json 默认按文件修改时间自动生效。
# HOT_RELOAD_WATCH=false
# HOT_RELOAD_INTERVAL=1.0

# 学校密码的独立加密密钥（32 字节 base64）。不配时由 APP_SECRET_KEY 派生，信封加密没有额外保护；
# 配了之后不能再改，否则已保存的密码全部解不开（用户需要重新登录）。
# CREDENTIAL_SECRET_KEY=
# 是否允许在数据库里（加密）保存学校密码。设为 false 后启动时会清掉已保存的密码，只靠长期 Cookie 续期。
# PASSWORD_STORAGE_ENABLED=true

# 兼容期开关：2.2.0 及更早的安卓 App 只会发 v1 设备签名。等新版 App 铺开后再设为 false，
# 否则旧版会收到 401 并清掉本机的托管记录。
# MOBILE_LEGACY_SIGNATURE=true

# 是否采信 X-Forwarded-For 最右一跳作为客户端 IP（限速用）。仅当反向代理一定会追加真实对端地址时才打开
# （如 Nginx 的 $proxy_add_x_forwarded_for）；仓库自带的 Apache 配置不需要。直连时打开等于允许伪造 IP。
# TRUST_FORWARDED_FOR=false
