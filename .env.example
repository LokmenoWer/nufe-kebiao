# 必填：32 字节随机密钥的 base64，用于 AES-256-GCM 加密落库的 cookie / 密码 / 订阅 token。
# 生成：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 生产环境请放在密钥管理服务 / 环境变量里，不要提交到仓库；丢失后已存凭据全部无法解密（用户重新登录即可）。
APP_SECRET_KEY=

# 对外访问地址（生成 .ics 订阅链接、校验 Origin 用）。https 开头时自动开启 Secure cookie + HSTS + 强制跳转。
PUBLIC_BASE_URL=http://localhost:8000

DB_PATH=./data/kebiao.db

# 后台刷新
SCHEDULER_ENABLED=true
REFRESH_INTERVAL_HOURS=12
# 只在这些小时（北京时间）发起后台刷新，避开上课和选课高峰
REFRESH_ALLOWED_HOURS=0-7,12-13,22-23
REFRESH_MAX_FAILS=3

# 发往学校服务器的节流
UPSTREAM_MAX_CONCURRENCY=2
# 任意两次请求的发起间隔（秒），最低 1.0：设得更小也会按 1.0 处理
UPSTREAM_MIN_INTERVAL=1.0
